---
interface Props {
	tags: string[];
}

const { tags } = Astro.props;
---

{
	tags.length > 0 && (
		<ul class="tag-list">
			{tags.map((tag) => (
				<li>
					<a href={`/tags/${tag}/`}>#{tag}</a>
				</li>
			))}
		</ul>
	)
}

<style>
	.tag-list {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.5rem;
		list-style: none;
		margin: 0 0 1em 0;
		padding: 0;
	}
	.tag-list a {
		padding: 0.1em 0.7em;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 999px;
		color: rgb(var(--gray));
		font-size: 0.85em;
		text-decoration: none;
	}
	.tag-list a:hover {
		color: rgb(var(--accent));
		border-color: rgb(var(--accent));
	}
</style>
