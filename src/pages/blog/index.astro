---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../../consts';
import { getCollection } from 'astro:content';
import FormattedDate from '../../components/FormattedDate.astro';
import HeroImage from '../../components/HeroImage.astro';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const tags = [...new Set(posts.flatMap((post) => post.data.tags))].sort((a, b) => a.localeCompare(b));
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 960px;
			}
			ul {
				display: flex;
				flex-wrap: wrap;
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				width: calc(50% - 1rem);
			}
			ul li * {
				text-decoration: none;
				transition: 0.2s ease;
			}
			ul li.featured {
				width: 100%;
				margin-bottom: 1rem;
				text-align: center;
			}
			ul li.featured img {
				width: 100%;
			}
			ul li.featured .title {
				font-size: 2.369rem;
			}
			ul li img {
				margin-bottom: 0.5rem;
				border-radius: 12px;
			}
			ul li a {
				display: block;
			}
			.title {
				margin: 0;
				color: rgb(var(--black));
				line-height: 1;
			}
			.date {
				margin: 0;
				color: rgb(var(--gray));
			}
			ul li a:hover h4,
			ul li a:hover .date {
				color: rgb(var(--accent));
			}
			.tag-filter {
					display: flex;
					flex-wrap: wrap;
					gap: 0.5rem;
					margin-bottom: 2rem;
				}
				.tag-filter a {
					padding: 0.2em 0.7em;
					border: 1px solid rgb(var(--gray-light));
					border-radius: 999px;
					color: rgb(var(--gray));
					text-decoration: none;
				}
				.tag-filter a:hover,
				.tag-filter a[aria-pressed='true'] {
					border-color: rgb(var(--accent));
					color: rgb(var(--accent));
				}
				ul a:hover img {
				box-shadow: var(--box-shadow);
			}
			@media (max-width: 720px) {
				ul {
					gap: 0.5em;
				}
				ul li {
					width: 100%;
					text-align: center;
				}
				ul li.featured {
					margin-bottom: 0;
				}
				ul li.featured .title {
					font-size: 1.563em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
					{
						tags.length > 0 && (
							<nav class="tag-filter" aria-label="Filter posts by tag">
								<a href="/blog/" data-tag="" aria-pressed="true">All</a>
								{tags.map((tag) => (
									<a href={`/tags/${tag}/`} data-tag={tag} aria-pressed="false">
										#{tag}
									</a>
								))}
							</nav>
						)
					}
				<ul>
					{
						posts.map((post, i) => (
							<li class={i === 0 ? 'featured' : undefined} data-tags={post.data.tags.join(',')}>
								<a href={`/blog/${post.id}/`}>
									{post.data.heroImage && <HeroImage src={post.data.heroImage} width={720} height={360} />}
									<h4 class="title">{post.data.title}</h4>
									<p class="date">
										<FormattedDate date={post.data.pubDate} />
									</p>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
		<script>
			const buttons = document.querySelectorAll<HTMLAnchorElement>('.tag-filter a');
			const items = document.querySelectorAll<HTMLLIElement>('ul li[data-tags]');

			function apply(tag: string) {
				let first = true;
				items.forEach((li) => {
					const show = !tag || li.dataset.tags!.split(',').includes(tag);
					li.hidden = !show;
					li.classList.toggle('featured', show && first);
					if (show) first = false;
				});
				buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.tag === tag)));
			}

			buttons.forEach((b) => {
				b.addEventListener('click', (e) => {
					e.preventDefault();
					const tag = b.dataset.tag ?? '';
					history.replaceState(null, '', tag ? `#${encodeURIComponent(tag)}` : location.pathname);
					apply(tag);
				});
			});

			const initial = decodeURIComponent(location.hash.slice(1));
			if (initial && [...buttons].some((b) => b.dataset.tag === initial)) apply(initial);
		</script>
	</body>
</html>
